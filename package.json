{
  "name": "cardiac-surgery-training",
  "private": true,
  "description": "CardiacSchool: zero-build static app in site/",
  "scripts": {
    "dev": "echo 'CardiacSchool running at http://127.0.0.1:8765/ (Ctrl+C to stop)' && python3 -m http.server 8765 --bind 127.0.0.1 --directory site",
    "validate": "node site/tools/validate.js",
    "validate:release": "node site/tools/validate-release.js",
    "check-links": "node site/tools/check-links.js",
    "check-links:network": "node site/tools/check-links.js --network",
    "seo": "node site/tools/gen-seo-files.js",
    "override-password": "node site/tools/set-override-password.js",
    "lighthouse": "npx -y lighthouse@12 http://127.0.0.1:8765/ --preset=desktop --output=html --output-path=./lighthouse-desktop.html --chrome-flags=--headless=new --quiet"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1"
  }
}
